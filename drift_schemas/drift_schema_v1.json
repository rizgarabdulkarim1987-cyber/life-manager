  "fixed_sql": [
    {
      "name": "workspaces",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"workspaces\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"icon_key\" TEXT NOT NULL, \"color_argb\" INTEGER NOT NULL, \"description\" TEXT NULL, \"notes\" TEXT NULL, \"sort_order\" INTEGER NOT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"workspace_id\" INTEGER NOT NULL REFERENCES workspaces (id) ON DELETE RESTRICT, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('cash', 'bank', 'savings', 'custom')), \"currency_code\" TEXT NOT NULL, \"opening_balance_minor\" INTEGER NOT NULL DEFAULT 0, \"sort_order\" INTEGER NOT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL DEFAULT 1 CHECK(\"id\" = 1), \"locale_code\" TEXT NOT NULL DEFAULT 'ar', \"theme_mode\" TEXT NOT NULL DEFAULT 'dark', \"lock_timeout_seconds\" INTEGER NOT NULL DEFAULT 300, \"biometric_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"biometric_enabled\" IN (0, 1)), \"base_currency\" TEXT NOT NULL DEFAULT 'IQD', \"setup_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"setup_completed\" IN (0, 1)), \"last_backup_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "backup_metadata",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"backup_metadata\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"created_at\" INTEGER NOT NULL, \"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('export', 'restore')), \"file_name\" TEXT NOT NULL, \"schema_version\" INTEGER NOT NULL, \"app_version\" TEXT NOT NULL, \"size_bytes\" INTEGER NOT NULL);"
        }
      ]
    }
  ]
